###############################################################################

SECRET_KEY='***'
DJANGO_DATABASE_HOST="db"
DJANGO_DATABASE_PASSWORD="***"
REDIS_URL='redis://redis:6379'
DEBUG=True
ROBOT_INDEX=False

ALLOWED_HOSTS=adheist.ai,www.adheist.ai
CSRF_TRUSTED_ORIGINS='https://adheist.ai'

GOOGLE_ANALYTICS_ID=''
POSTHOG_KEY='***'
POSTHOG_HOST='https://us.i.posthog.com'


STRIPE_LIVE_PUBLIC_KEY="pk_test_***"
STRIPE_LIVE_SECRET_KEY="sk_test_***"
STRIPE_PRICING_TABLE_ID="prctbl_***"
DJSTRIPE_WEBHOOK_SECRET="whsec_***"
DJSTRIPE_WEBHOOK_VALIDATION="verify_signature"
STRIPE_LIVE_MODE=True

# public media storage config
USE_S3_MEDIA=True
AWS_STORAGE_BUCKET_NAME='adheist-s3-prod'
AWS_ACCESS_KEY_ID='***'
AWS_SECRET_ACCESS_KEY='***'

# Email settings
DEFAULT_FROM_EMAIL="hey@adheist.ai"
SERVER_EMAIL="noreply@adheist.ai"
EMAIL_BACKEND="anymail.backends.resend.EmailBackend"
RESEND_API_KEY="key-***"
RESEND_API_URL="https://api.resend.com"
ACCOUNT_EMAIL_VERIFICATION="mandatory"
ACCOUNT_EMAIL_VERIFICATION_BY_CODE_ENABLED=True
EMAIL_SUBJECT_PREFIX="[AdHeist] "

# Django security checklist settings.
# More details here: https://docs.djangoproject.com/en/stable/howto/deployment/checklist/
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# fix ssl mixed content issues
USE_HTTPS_IN_ABSOLUTE_URLS=True

# HTTP Strict Transport Security settings
# Without uncommenting the lines below, you will get security warnings when running ./manage.py check --deploy
# https://docs.djangoproject.com/en/stable/ref/middleware/#http-strict-transport-security

# # Increase this number once you're confident everything works https://stackoverflow.com/a/49168623/8207
SECURE_HSTS_SECONDS=60
# # Uncomment these two lines if you are sure that you don't host any subdomains over HTTP.
# # You will get security warnings if you don't do this.
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# OPENAI_API_KEY=""
OPENAI_API_KEY=""

CMS_BLOG_ENDPOINT=""
CMS_BLOG_KEY=""

APP_ENV="prod"

# Static files versioning for cache busting
# Increment this version when deploying changes to force browser cache refresh
STATIC_VERSION=1.0.0
