# For EC2 deployment (SSL):
server {
    server_name stage.adheist.ai www.stage.adheist.ai;

    location /static/ {
        alias /code/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias /code/media/;
        access_log off;
        expires 30d;
    }

    # Make sure we forward the original protocol (https) to Django
    location / {
        proxy_pass http://127.0.0.1:8000;  # Django is running on port 8000
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;  # Pass HTTPS protocol info to Django
        
        # Performance optimizations
        proxy_buffering off;  # Don't buffer responses, send them directly to client
        proxy_read_timeout 300s;  # Allow longer reads for slow responses
        proxy_connect_timeout 75s;
        proxy_send_timeout 300s;
        
        # Connection reuse
        proxy_http_version 1.1;  # Use HTTP 1.1 for better connection reuse
        proxy_set_header Connection "";  # Enable keepalive connections
        
        # Add timing header for debugging
        add_header X-Proxy-Response-Time $upstream_response_time;
    }

    # Increase timeouts for specific endpoints known to be slow
    location ~ ^/ads/adrequest/[0-9]+/get/$ {
        proxy_pass http://127.0.0.1:8000;  
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Strong performance optimizations for this endpoint
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_send_timeout 300s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        
        # Add timing header to see response time components
        add_header X-Proxy-Response-Time $upstream_response_time;
        add_header X-Adheist-Route "adrequest-get";
    }

    listen 443 ssl; # SSL enabled on port 443
    ssl_certificate /etc/letsencrypt/live/stage.adheist.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stage.adheist.ai/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# Redirect HTTP to HTTPS for production
server {
    listen 80;
    server_name stage.adheist.ai www.stage.adheist.ai;
    # Redirect all HTTP requests to HTTPS
    return 301 https://$host$request_uri;
}
